# Example environment for fasttask-sidecar.service (doc/tech.md §21.4, doc/harness.md §8.2).
#
# Install as /etc/fasttask/sidecar.env, owned by root:fasttask with mode 0640. The same
# FASTTASK_SIDECAR_SECRET and FASTTASK_SIDECAR_SOCKET must appear in /etc/fasttask/fasttask.env, together
# with FASTTASK_SIDECAR_ENABLED=true and FASTTASK_SIDECAR_SPAWN=false, so the server probes this unit
# instead of starting a child of its own.
#
# No model credential belongs in this file. The sidecar calls the server's OpenAI-compatible proxy and the
# real provider key is injected inside the Go process (doc/harness.md §4.5).

# The capability secret both sides authenticate with. Generate one with:
#   openssl rand -hex 32
FASTTASK_SIDECAR_SECRET=

# Where this unit listens. A unix socket is preferred; a TCP address must be loopback and must carry a
# port. Never 0.0.0.0, and never reachable through the reverse proxy.
FASTTASK_SIDECAR_ENDPOINT=unix:///run/fasttask-sidecar/sidecar.sock

# The server the sidecar calls back into: the model proxy, the tool surface, the heartbeat. Loopback,
# because a run capability must not cross a network.
FASTTASK_SERVER_ORIGIN=http://127.0.0.1:2233

# The web workspace whose node_modules holds libfx. The sidecar resolves libfx from here rather than
# installing a second copy of the native addons.
FASTTASK_WEB_ROOT=/opt/fasttask/web

# Informational: reported by /healthz and compared against the server's own libfx version, so a checkpoint
# written by one version is not handed to another (doc/harness.md §6.3).
FASTTASK_LIBFX_VERSION=0.0.10
